+/*
+ * CLAPACK Compatibility Layer for xeus-octave WASM build
+ * 
+ * This file provides compatibility support for CLAPACK 3.2.1 limitations
+ * when building xeus-octave for WebAssembly.
+ */
+
+#ifdef XEUS_OCTAVE_EMSCRIPTEN_WASM_BUILD
+
+#include <iostream>
+#include <sstream>
+#include <stdexcept>
+#include <cstring>
+
+// Error handling for CLAPACK-specific issues
+namespace xeus_octave {
+namespace clapack {
+
+// CLAPACK error codes
+constexpr int CLAPACK_FUNCTION_NOT_AVAILABLE = -999;
+constexpr int CLAPACK_INVALID_ARGUMENT = -1;
+
+// Helper function to check LAPACK info return values
+void check_lapack_info(int info, const char* function_name) {
+    if (info == 0) {
+        return; // Success
+    }
+    
+    if (info == CLAPACK_FUNCTION_NOT_AVAILABLE) {
+        std::ostringstream msg;
+        msg << "LAPACK function '" << function_name 
+            << "' is not available in CLAPACK 3.2.1.\n"
+            << "This function was added in LAPACK 3.3+ and is not supported in the WebAssembly build.\n"
+            << "Consider using an alternative algorithm or function.";
+        throw std::runtime_error(msg.str());
+    }
+    
+    if (info < 0) {
+        std::ostringstream msg;
+        msg << "LAPACK function '" << function_name 
+            << "' was called with invalid argument " << (-info);
+        throw std::invalid_argument(msg.str());
+    }
+    
+    // info > 0 usually means computational failure
+    std::ostringstream msg;
+    msg << "LAPACK function '" << function_name 
+        << "' failed with info = " << info;
+    throw std::runtime_error(msg.str());
+}
+
+// List of functions not available in CLAPACK 3.2.1
+const char* unavailable_functions[] = {
+    "zgejsv", "cgejsv", "dgejsv", "sgejsv",  // Added in LAPACK 3.3
+    "zggsvd3", "cggsvd3", "dggsvd3", "sggsvd3",  // Added in LAPACK 3.6
+    "zgges3", "cgges3", "dgges3", "sgges3",  // Added in LAPACK 3.6
+    nullptr
+};
+
+// Check if a function is known to be unavailable
+bool is_function_unavailable(const char* function_name) {
+    for (int i = 0; unavailable_functions[i] != nullptr; ++i) {
+        if (strcmp(function_name, unavailable_functions[i]) == 0) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// Initialize CLAPACK compatibility (called from xinterpreter.cpp)
+void initialize() {
+    // Set any CLAPACK-specific environment variables or flags
+    // Currently, CLAPACK doesn't require special initialization
+    
+    // Log CLAPACK usage for debugging
+#ifdef DEBUG
+    std::cerr << "xeus-octave: Using CLAPACK 3.2.1 for BLAS/LAPACK operations" << std::endl;
+    std::cerr << "xeus-octave: Note - Some LAPACK 3.3+ functions are not available" << std::endl;
+#endif
+}
+
+} // namespace clapack
+} // namespace xeus_octave
+
+// If needed, provide C-compatible error checking functions
+extern "C" {
+
+// Wrapper for LAPACK info checking from C code
+void xeus_octave_check_lapack_info(int info, const char* function_name) {
+    xeus_octave::clapack::check_lapack_info(info, function_name);
+}
+
+// Check if a LAPACK function is available
+int xeus_octave_is_lapack_function_available(const char* function_name) {
+    return xeus_octave::clapack::is_function_unavailable(function_name) ? 0 : 1;
+}
+
+} // extern "C"
+
+#endif // XEUS_OCTAVE_EMSCRIPTEN_WASM_BUILD 
