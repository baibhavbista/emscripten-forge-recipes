+++ b/verify_clapack.sh
@@ -0,0 +1,87 @@
+#!/bin/bash
+# Verification script for CLAPACK integration in xeus-octave WASM build
+set -e
+
+echo "=== xeus-octave CLAPACK Verification Script ==="
+echo
+
+# Check if build directory exists
+if [ ! -d "build" ]; then
+    echo "ERROR: build directory not found. Please build the project first."
+    exit 1
+fi
+
+# Check for the wasm file
+WASM_FILE="build/xoctave.wasm"
+if [ ! -f "$WASM_FILE" ]; then
+    echo "ERROR: $WASM_FILE not found. Please build the project first."
+    exit 1
+fi
+
+echo "1. Checking for OpenBLAS references..."
+if nm -u "$WASM_FILE" 2>/dev/null | grep -i openblas; then
+    echo "   ❌ ERROR: OpenBLAS symbols found in WASM binary!"
+    echo "   This indicates the build is still linking against OpenBLAS."
+    exit 1
+else
+    echo "   ✅ Good: No OpenBLAS symbols found"
+fi
+
+echo
+echo "2. Checking for CLAPACK/F2C symbols..."
+# Look for common CLAPACK/BLAS function symbols
+CLAPACK_SYMBOLS=$(nm "$WASM_FILE" 2>/dev/null | grep -E "dgemm_|dgemv_|dgetrf_|f2c_" | head -5)
+if [ -n "$CLAPACK_SYMBOLS" ]; then
+    echo "   ✅ Good: CLAPACK symbols found:"
+    echo "$CLAPACK_SYMBOLS" | sed 's/^/      /'
+else
+    echo "   ⚠️  WARNING: No obvious CLAPACK symbols found"
+    echo "   This might be okay if symbols are internalized"
+fi
+
+echo
+echo "3. Checking pkg-config output..."
+if command -v pkg-config &> /dev/null; then
+    echo "   octinterp libs: $(pkg-config --libs octinterp 2>/dev/null || echo 'pkg-config not configured')"
+else
+    echo "   ⚠️  pkg-config not available to verify"
+fi
+
+echo
+echo "4. Checking for thread stub issues..."
+# The build.sh should have removed these
+if [ -f "$PREFIX/lib/octave/7.2.0/liboctinterp.a" ]; then
+    if ar t "$PREFIX/lib/octave/7.2.0/liboctinterp.a" 2>/dev/null | grep -q "liboctave_stubs.a"; then
+        echo "   ❌ ERROR: liboctave_stubs.a still present in liboctinterp.a"
+        exit 1
+    else
+        echo "   ✅ Good: No thread stubs in liboctinterp.a"
+    fi
+else
+    echo "   ℹ️  Skipping stub check (Octave libs not in expected location)"
+fi
+
+echo
+echo "5. Checking linked libraries in wasm..."
+# Use wasm-objdump if available
+if command -v wasm-objdump &> /dev/null; then
+    echo "   Imports in WASM module:"
+    wasm-objdump -x "$WASM_FILE" | grep -E "import|NEEDED" | head -10 | sed 's/^/      /'
+else
+    echo "   ℹ️  wasm-objdump not available for detailed analysis"
+fi
+
+echo
+echo "6. Checking CLAPACK compatibility layer..."
+# Check if compatibility layer symbols are present
+if nm "$WASM_FILE" 2>/dev/null | grep -q "xeus_octave_check_lapack_info\|clapack.*initialize"; then
+    echo "   ✅ Good: CLAPACK compatibility layer is included"
+else
+    echo "   ⚠️  WARNING: CLAPACK compatibility layer symbols not found"
+fi
+
+echo
+echo "=== Verification Summary ==="
+echo "If all checks passed (✅), the build is correctly using CLAPACK."
+echo "Any ❌ errors indicate issues that need to be fixed."
+echo 
