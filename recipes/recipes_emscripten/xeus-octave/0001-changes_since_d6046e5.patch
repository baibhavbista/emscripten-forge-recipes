diff --git a/cmake/WasmBuildOptions.cmake b/cmake/WasmBuildOptions.cmake
new file mode 100644
index 0000000..eb4a665
--- /dev/null
+++ b/cmake/WasmBuildOptions.cmake
@@ -0,0 +1,37 @@
+# Options for WASM builds
+macro(xeus_wasm_compile_options target_name)
+    target_compile_options(${target_name}
+        PUBLIC
+            -sWASM=1
+            -sALLOW_MEMORY_GROWTH
+            -sSTRICT=1
+            -sNO_EXIT_RUNTIME=1
+            -sMODULARIZE=1
+            -sEXPORT_ES6=1
+            -sUSE_ES6_IMPORT_META=0
+            "-sEXPORTED_RUNTIME_METHODS=[\"callMain\",\"FS\",\"ENV\"]"
+            -sENVIRONMENT=web,worker
+    )
+endmacro()
+
+macro(xeus_wasm_link_options target_name env)
+    target_link_options(${target_name}
+        PUBLIC
+            -sWASM=1
+            -sALLOW_MEMORY_GROWTH
+            -sSTRICT=1
+            -sNO_EXIT_RUNTIME=1
+            -sMODULARIZE=1
+            -sEXPORT_ES6=1
+            -sUSE_ES6_IMPORT_META=0
+            "-sEXPORTED_RUNTIME_METHODS=[\"callMain\",\"FS\",\"ENV\"]"
+            -sENVIRONMENT=${env}
+            -sINITIAL_MEMORY=256MB  # CLAPACK needs more memory
+            -sMAXIMUM_MEMORY=2GB
+            # Add these two lines for C++ ABI and standard library support
+            -lc++
+            -lc++abi
+    )
+endmacro()
