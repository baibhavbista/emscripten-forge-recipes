+
+disp('=== CLAPACK Compatibility Test ===');
+disp('');
+
+% Test 1: Basic matrix multiplication (uses dgemm)
+disp('Test 1: Matrix multiplication (BLAS dgemm)');
+A = rand(3, 3);
+B = rand(3, 3);
+C = A * B;
+disp('  ✓ Matrix multiplication successful');
+disp('');
+
+% Test 2: LU decomposition (uses dgetrf)
+disp('Test 2: LU decomposition (LAPACK dgetrf)');
+[L, U, P] = lu(A);
+disp('  ✓ LU decomposition successful');
+disp('');
+
+% Test 3: Matrix inversion (uses dgetri)
+disp('Test 3: Matrix inversion (LAPACK dgetri)');
+Ainv = inv(A);
+disp('  ✓ Matrix inversion successful');
+disp('');
+
+% Test 4: Eigenvalue decomposition (uses dgeev)
+disp('Test 4: Eigenvalue decomposition (LAPACK dgeev)');
+[V, D] = eig(A);
+disp('  ✓ Eigenvalue decomposition successful');
+disp('');
+
+% Test 5: Singular value decomposition (uses dgesvd)
+disp('Test 5: SVD (LAPACK dgesvd)');
