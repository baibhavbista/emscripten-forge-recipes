Disable GEJSV functions for CLAPACK compatibility

CLAPACK 3.2.1 doesn't have these functions which were added in LAPACK 3.6.0.
This patch disables their use in Octave's SVD implementation.

--- a/configure
+++ b/configure
@@ -43000,6 +43000,10 @@
 
 ac_fn_c_check_func "$LINENO" "cgejsv_" "ac_cv_func_cgejsv_"
+# Force cgejsv_ to be unavailable for CLAPACK compatibility
+ac_cv_func_cgejsv_=no
+echo "Forcing ac_cv_func_cgejsv_=no for CLAPACK compatibility"
+
 if test "x$ac_cv_func_cgejsv_" = xyes
 then :
   printf "%s\n" "#define HAVE_CGEJSV 1" >>confdefs.h
@@ -43007,6 +43011,10 @@
 fi
 
 ac_fn_c_check_func "$LINENO" "dgejsv_" "ac_cv_func_dgejsv_"
+# Force dgejsv_ to be unavailable for CLAPACK compatibility
+ac_cv_func_dgejsv_=no
+echo "Forcing ac_cv_func_dgejsv_=no for CLAPACK compatibility"
+
 if test "x$ac_cv_func_dgejsv_" = xyes
 then :
   printf "%s\n" "#define HAVE_DGEJSV 1" >>confdefs.h
@@ -43014,6 +43022,10 @@
 fi
 
 ac_fn_c_check_func "$LINENO" "sgejsv_" "ac_cv_func_sgejsv_"
+# Force sgejsv_ to be unavailable for CLAPACK compatibility
+ac_cv_func_sgejsv_=no
+echo "Forcing ac_cv_func_sgejsv_=no for CLAPACK compatibility"
+
 if test "x$ac_cv_func_sgejsv_" = xyes
 then :
   printf "%s\n" "#define HAVE_SGEJSV 1" >>confdefs.h
@@ -43021,6 +43033,10 @@
 fi
 
 ac_fn_c_check_func "$LINENO" "zgejsv_" "ac_cv_func_zgejsv_"
+# Force zgejsv_ to be unavailable for CLAPACK compatibility
+ac_cv_func_zgejsv_=no
+echo "Forcing ac_cv_func_zgejsv_=no for CLAPACK compatibility"
+
 if test "x$ac_cv_func_zgejsv_" = xyes
 then :
   printf "%s\n" "#define HAVE_ZGEJSV 1" >>confdefs.h 